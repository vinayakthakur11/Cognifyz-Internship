#include <iostream>
#include <vector>
#include <string>
#include <fstream>
#include <sstream> // Include this header for stringstream

using namespace std;

class Task {
public:
    int id;
    string description;
    bool isCompleted;

    Task(int id, string description) : id(id), description(description), isCompleted(false) {}
};

class TaskManager {
private:
    vector<Task> tasks;
    int nextId;
    string filename = "tasks.txt";

public:
    TaskManager() : nextId(1) {
        loadTasksFromFile();
    }

    void createTask(string description) {
        tasks.push_back(Task(nextId++, description));
        cout << "Task created successfully." << endl;
        saveTasksToFile();
    }

    void readTasks() {
        if (tasks.empty()) {
            cout << "No tasks found." << endl;
        } else {
            cout << "Task List:" << endl;
            for (const Task& task : tasks) {
                cout << "ID: " << task.id << ", Description: " << task.description << ", Completed: " << (task.isCompleted ? "Yes" : "No") << endl;
            }
        }
    }

    void updateTask(int id, string newDescription) {
        for (Task& task : tasks) {
            if (task.id == id) {
                task.description = newDescription;
                cout << "Task updated successfully." << endl;
                saveTasksToFile();
                return;
            }
        }
        cout << "Task not found." << endl;
    }

    void deleteTask(int id) {
        for (auto it = tasks.begin(); it != tasks.end(); ++it) {
            if (it->id == id) {
                tasks.erase(it);
                cout << "Task deleted successfully." << endl;
                saveTasksToFile();
                return;
            }
        }
        cout << "Task not found." << endl;
    }

    void saveTasksToFile() {
        ofstream file(filename);
        if (file.is_open()) {
            for (const Task& task : tasks) {
                file << task.id << "," << task.description << "," << (task.isCompleted ? "1" : "0") << endl;
            }
            file.close();
            cout << "Tasks saved to file." << endl;
        } else {
            cerr << "Error opening file for writing." << endl;
        }
    }

    void loadTasksFromFile() {
        ifstream file(filename);
        if (file.is_open()) {
            string line;
            while (getline(file, line)) {
                int id;
                string description;
                bool isCompleted;
                stringstream ss(line); // Initialize stringstream object

                if (ss >> id >> description >> isCompleted) { // Check if extraction was successful
                    tasks.push_back(Task(id, description));
                    if (isCompleted) {
                        tasks.back().isCompleted = true;
                    }
                    nextId = max(nextId, id + 1);
                } else {
                    cerr << "Error parsing line: " << line << endl;
                }
            }
            file.close();
            cout << "Tasks loaded from file." << endl;
        } else {
            cerr << "Error opening file for reading." << endl;
        }
    }
};

int main() {
    TaskManager taskManager;
    int choice;

    while (true) {
        cout << "\nTask Manager\n";
        cout << "1. Create Task\n";
        cout << "2. Read Tasks\n";
        cout << "3. Update Task\n";
        cout << "4. Delete Task\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: {
                string description;
                cout << "Enter task description: ";
                cin.ignore();
                getline(cin, description);
                taskManager.createTask(description);
                break;
            }
            case 2:
                taskManager.readTasks();
                break;
            case 3: {
                int id;
                string newDescription;
                cout << "Enter task ID to update: ";
                cin >> id;
                cout << "Enter new description: ";
                cin.ignore();
                getline(cin, newDescription);
                taskManager.updateTask(id, newDescription);
                break;
            }
            case 4: {
                int id;
                cout << "Enter task ID to delete: ";
                cin >> id;
                taskManager.deleteTask(id);
                break;
            }
            case 5:
                cout << "Exiting...\n";
                return 0;
            default:
                cout << "Invalid choice. Please try again.\n";
        }
    }
}
